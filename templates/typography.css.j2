html {
  font-size: 16px;
}

body {
  font-family: 'IBM Plex Serif', Georgia, serif;
  font-weight: 400;
  line-height: 1.65;
}

p {
  font-size: 1rem;
}

h1,
h2,
h3,
h4,
h5 {
  font-family: 'IBM Plex Serif', Georgia, serif;
  font-weight: 700;
  line-height: 1.15;
}

h1,
.text-size-h1 {
  font-family: 'IBM Plex Serif', Georgia, serif;
  font-weight: 400;
  margin-top: 0;
  font-size: 3.052rem;
}

h2,
.text-size-h2 { font-size: 2.441rem; }

h3,
.text-size-h3 {
  font-size: 1.953rem;
  font-weight: 400;
}

h4,
.text-size-h4 { font-size: 1.563rem; }

h5,
.text-size-h5 { font-size: 1.25rem; }

.text-caption { font-size: 0.875rem; }

small,
.text-small {
  font-size: 0.8rem;
}
