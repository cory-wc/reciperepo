<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
{% if mode == 'screen' %}
{% include 'theme-init.html.j2' %}
{% endif %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap" rel="stylesheet">
<style>
  {% include 'typography.css.j2' %}
  {% if mode == 'print' %}
  @page { size: Letter; margin: 0.75in; }
  {% endif %}
  body {
    color: #2e2b28;
  }
  h1 { text-align: center; }
  .meta { text-align: center; color: #666; margin-bottom: 1.5rem; }
{% if mode == 'screen' %}
  .index-header { position: relative; }
  .index-header .meta {
    position: absolute;
    top: 0;
    right: 0;
    margin: 0;
  }
  .recipe-search { margin-bottom: 1.25rem; }
  .recipe-search label {
    display: block;
    font-weight: 700;
    margin-bottom: 0.35rem;
    font-size: 1.25rem;
    line-height: 1.15;
  }
  .recipe-search-field { position: relative; }
  .recipe-search-input-wrap { position: relative; }
  .recipe-search-icon {
    position: absolute;
    left: 0.65rem;
    top: 50%;
    transform: translateY(-50%);
    width: 1rem;
    height: 1rem;
    color: #666;
    pointer-events: none;
  }
  .recipe-search-icon svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .recipe-search input {
    box-sizing: border-box;
    width: 100%;
    padding: 0.55rem 0.65rem 0.55rem 2.25rem;
    border: 1px solid #aaa;
    border-radius: 0.25rem;
    color: inherit;
    font: inherit;
    background: #fff;
  }
  .recipe-search-field.open .recipe-search-input-wrap input {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }
  .recipe-search-suggestions {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    background: #fff;
    border: 1px solid #aaa;
    border-top: none;
    border-radius: 0 0 0.25rem 0.25rem;
    max-height: 12rem;
    overflow-y: auto;
    z-index: 10;
  }
  .recipe-search-suggestions li {
    padding: 0.55rem 0.65rem;
    color: #504a43;
    border-top: 1px solid #504a43;
    cursor: pointer;
  }
  .recipe-search-suggestions li:hover,
  .recipe-search-suggestions li[aria-selected="true"] {
    background: #f5f3f0;
  }
  .recipe-alpha-index {
    display: flex;
    flex-wrap: nowrap;
    justify-content: space-between;
    width: 100%;
    margin-top: 24px;
    margin-bottom: 1.25rem;
  }
  .recipe-alpha-letter {
    border: none;
    background: transparent;
    color: #504a43;
    padding: 0.15rem 0;
    font: inherit;
    line-height: 1.2;
    cursor: pointer;
    flex: 1 1 0;
    min-width: 0;
    text-align: center;
  }
  .recipe-alpha-letter:hover:not(:disabled) {
    color: #2e2b28;
    text-decoration: underline;
  }
  .recipe-alpha-letter.active {
    color: #2e2b28;
    font-weight: 700;
    text-decoration: underline;
  }
  .recipe-alpha-letter:disabled {
    opacity: 0.35;
    cursor: default;
  }
  th.sortable { cursor: pointer; user-select: none; }
  th.sortable:hover { color: #504a43; }
  th.sortable::after {
    content: '↕';
    margin-left: 0.35rem;
    font-size: 0.75em;
    opacity: 0.35;
  }
  th.sortable[aria-sort="ascending"]::after {
    content: '↑';
    opacity: 1;
  }
  th.sortable[aria-sort="descending"]::after {
    content: '↓';
    opacity: 1;
  }
  #recipe-table tbody td:not(:first-child) {
    font-size: 0.875rem;
  }
  .ingredient-cell summary {
    display: inline;
    cursor: pointer;
    list-style: none;
  }
  .ingredient-cell summary::-webkit-details-marker {
    display: none;
  }
  .ingredient-cell summary::marker {
    content: '';
  }
  .ingredient-list {
    display: inline;
  }
  .ingredient-list .ingredient-name::before {
    content: ', ';
  }
  .ingredient-more {
    white-space: nowrap;
  }
  .ingredient-cell details[open] .ingredient-more {
    display: none;
  }
{% endif %}
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.35rem 0.5rem; border-bottom: 1px solid #ddd; }
  th {
    font-weight: 700;
    line-height: 1.15;
    font-size: 1.25rem;
    border-bottom: 2px solid #504a43;
  }
  .tags { color: #666; }
  a { color: #504a43; text-decoration: none; }
  a:hover { text-decoration: underline; }
  .pdf-ref { color: #666; }
{% if mode == 'print' %}
  h1 { font-size: 24pt; font-weight: 400; }
  table { font-size: 11pt; }
  .tags, .pdf-ref { font-size: 0.875rem; }
{% endif %}
{% if mode == 'screen' %}
{% include 'responsive.css.j2' %}
{% include 'theme.css.j2' %}
{% endif %}
</style>
</head>
<body class="index-page">
  <header class="index-header">
    <h1>{{ title }}</h1>
    <p class="meta text-caption">Generated {{ generated_at }}{% if sort_by != 'name' %} · sorted by {{ sort_by }}{% endif %}</p>
  </header>
{% if mode == 'screen' %}
  <div class="recipe-search">
    <label for="recipe-search">Search recipes</label>
    <div class="recipe-search-field">
      <div class="recipe-search-input-wrap">
        <span class="recipe-search-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" focusable="false">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="16.5" y1="16.5" x2="21" y2="21"></line>
          </svg>
        </span>
        <input id="recipe-search" type="search" placeholder="Search by recipe, tag, ingredient, or yield" autocomplete="off" role="combobox" aria-expanded="false" aria-controls="recipe-search-suggestions" aria-autocomplete="list">
      </div>
      <ul id="recipe-search-suggestions" class="recipe-search-suggestions" role="listbox" hidden></ul>
    </div>
    <nav id="recipe-alpha-index" class="recipe-alpha-index text-small" aria-label="Filter recipes by letter"></nav>
  </div>
{% endif %}
  <table id="recipe-table">
    <thead>
      <tr>
{% if mode == 'screen' %}
        <th class="sortable" data-column="0" aria-sort="ascending">Recipe</th>
        <th class="sortable" data-column="1">Tags</th>
        <th class="sortable" data-column="2">Ingredients</th>
        <th class="sortable" data-column="3">Yield</th>
{% else %}
        <th>Recipe</th>
        <th>Yield</th>
{% endif %}
{% if mode == 'print' %}        <th>PDF file</th>{% endif %}
      </tr>
    </thead>
    <tbody>
{% for recipe in recipes %}
      <tr>
        <td data-label="Recipe">
{% if mode == 'screen' %}
          <a href="{{ recipe.links.html.split('/')[-1] }}">{{ recipe.name }}</a>
{% else %}
          {{ recipe.name }}
{% endif %}
        </td>
{% if mode == 'screen' %}
        <td class="tags" data-label="Tags">{{ (recipe.tags or []) | join(', ') }}</td>
{% set ingredient_names = recipe.ingredients or [] %}
        <td class="ingredient-cell" data-label="Ingredients" data-sort-value="{{ ingredient_names[0] if ingredient_names else '' }}">
{% if ingredient_names | length > 3 %}
          <details>
            <summary>{% for ingredient in ingredient_names[:3] %}<span class="ingredient-name">{{ ingredient }}</span>{% if not loop.last %}, {% endif %}{% endfor %}<span class="ingredient-more"> +{{ (ingredient_names | length) - 3 }} more</span></summary><span class="ingredient-list">{% for ingredient in ingredient_names[3:] %}<span class="ingredient-name">{{ ingredient }}</span>{% endfor %}</span>
          </details>
{% else %}
          {% for ingredient in ingredient_names %}<span class="ingredient-name">{{ ingredient }}</span>{% if not loop.last %}, {% endif %}{% endfor %}
{% endif %}
        </td>
{% endif %}
        <td data-label="Yield">{{ recipe.yield }}</td>
{% if mode == 'print' %}
        <td class="pdf-ref" data-label="PDF file">{{ recipe.links.pdf.split('/')[-1] }}</td>
{% endif %}
      </tr>
{% endfor %}
    </tbody>
  </table>
{% if mode == 'screen' %}
  <script>
    const searchInput = document.querySelector('#recipe-search');
    const searchField = document.querySelector('.recipe-search-field');
    const suggestionsList = document.querySelector('#recipe-search-suggestions');
    const alphaIndex = document.querySelector('#recipe-alpha-index');
    const sortHeaders = Array.from(document.querySelectorAll('th.sortable'));
    const recipeBody = document.querySelector('#recipe-table tbody');
    const recipeRows = Array.from(recipeBody.querySelectorAll('tr'));
    const ingredientDetails = Array.from(document.querySelectorAll('.ingredient-cell details'));
    const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
    let sortColumn = 0;
    let sortDirection = 1;
    let activeLetter = null;
    const alphaButtons = [];
    const suggestions = Array.from(new Set(
      recipeRows.flatMap((row) =>
        Array.from(row.querySelectorAll('td'))
          .flatMap((cell) => {
            const ingredientNames = Array.from(cell.querySelectorAll('.ingredient-name'))
              .map((ingredient) => ingredient.textContent.trim())
              .filter(Boolean);
            return ingredientNames.length ? ingredientNames : [cell.textContent.trim()];
          })
          .filter(Boolean)
      )
    )).sort((a, b) => a.localeCompare(b));

    ingredientDetails.forEach((details) => {
      details.addEventListener('toggle', () => {
        if (!details.open) return;
        ingredientDetails.forEach((otherDetails) => {
          if (otherDetails !== details) otherDetails.open = false;
        });
      });
    });

    document.addEventListener('click', (event) => {
      if (event.target.closest('.ingredient-cell details')) return;
      ingredientDetails.forEach((details) => {
        details.open = false;
      });
    });

    function recipeName(row) {
      return row.cells[0].textContent.trim();
    }

    function recipeMatchesLetter(name, letter) {
      return name
        .toLocaleLowerCase()
        .split(/\s+/)
        .some((word) => word.replace(/^[^a-z0-9]+/u, '').startsWith(letter.toLocaleLowerCase()));
    }

    function updateAlphaButtons() {
      alphaButtons.forEach((button) => {
        const letter = button.dataset.letter;
        const hasMatches = recipeRows.some((row) => recipeMatchesLetter(recipeName(row), letter));
        button.disabled = !hasMatches;
        button.classList.toggle('active', letter === activeLetter);
        button.setAttribute('aria-pressed', letter === activeLetter ? 'true' : 'false');
      });
    }

    function filterRows() {
      const query = searchInput.value.trim().toLocaleLowerCase();
      recipeRows.forEach((row) => {
        const matchesSearch = !query || row.textContent.toLocaleLowerCase().includes(query);
        const matchesLetter = !activeLetter || recipeMatchesLetter(recipeName(row), activeLetter);
        row.hidden = !(matchesSearch && matchesLetter);
      });
    }

    function hideSuggestions() {
      suggestionsList.hidden = true;
      suggestionsList.replaceChildren();
      searchField.classList.remove('open');
      searchInput.setAttribute('aria-expanded', 'false');
    }

    function showSuggestions() {
      const query = searchInput.value.trim().toLocaleLowerCase();
      if (!query) {
        hideSuggestions();
        return;
      }
      const matches = suggestions.filter((value) => value.toLocaleLowerCase().includes(query));
      suggestionsList.replaceChildren();
      matches.slice(0, 12).forEach((value) => {
        const item = document.createElement('li');
        item.textContent = value;
        item.setAttribute('role', 'option');
        item.addEventListener('mousedown', (event) => {
          event.preventDefault();
          searchInput.value = value;
          filterRows();
          hideSuggestions();
        });
        suggestionsList.appendChild(item);
      });
      const hasMatches = matches.length > 0;
      suggestionsList.hidden = !hasMatches;
      searchField.classList.toggle('open', hasMatches);
      searchInput.setAttribute('aria-expanded', hasMatches ? 'true' : 'false');
    }

    searchInput.addEventListener('input', () => {
      filterRows();
      showSuggestions();
    });

    searchInput.addEventListener('focus', showSuggestions);
    searchInput.addEventListener('blur', () => {
      window.setTimeout(hideSuggestions, 100);
    });

    'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('').forEach((letter) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'recipe-alpha-letter';
      button.dataset.letter = letter;
      button.textContent = letter;
      button.setAttribute('aria-pressed', 'false');
      button.addEventListener('click', () => {
        activeLetter = activeLetter === letter ? null : letter;
        updateAlphaButtons();
        filterRows();
      });
      alphaIndex.appendChild(button);
      alphaButtons.push(button);
    });
    updateAlphaButtons();

    function updateHeaderState() {
      sortHeaders.forEach((header) => {
        const column = Number(header.dataset.column);
        if (column === sortColumn) {
          header.setAttribute('aria-sort', sortDirection === 1 ? 'ascending' : 'descending');
        } else {
          header.removeAttribute('aria-sort');
        }
      });
    }

    function sortRows() {
      recipeRows
        .sort((a, b) => {
          const aCell = a.cells[sortColumn];
          const bCell = b.cells[sortColumn];
          const aValue = aCell.dataset.sortValue ?? aCell.textContent.trim();
          const bValue = bCell.dataset.sortValue ?? bCell.textContent.trim();
          const primary = collator.compare(
            aValue,
            bValue
          ) * sortDirection;
          return primary || collator.compare(
            a.cells[0].textContent.trim(),
            b.cells[0].textContent.trim()
          ) * sortDirection;
        })
        .forEach((row) => recipeBody.appendChild(row));
      updateHeaderState();
    }

    sortHeaders.forEach((header) => {
      header.addEventListener('click', () => {
        const column = Number(header.dataset.column);
        if (column === sortColumn) {
          sortDirection *= -1;
        } else {
          sortColumn = column;
          sortDirection = 1;
        }
        sortRows();
      });
    });

    sortRows();
  </script>
{% endif %}
</body>
</html>
